{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmartClinicDB;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning",
                "Hangfire": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/app-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Key": "",
        "Issuer": "SmartClinicApi",
        "Audience": "SmartClinicClient"
    },
    "AllowedOrigins": [],
    "GeminiSettings": {
        "ApiKey": ""
    },
    "Email": {
        "SmtpHost": "smtp.gmail.com",
        "SmtpPort": 587,
        "SmtpUser": "newfaces.office@gmail.com",
        "SmtpPassword": "spge gfnc eqjl ighq",
        "FromAddress": "newfaces.office@gmail.com",
        "FromName": "SmartClinic",
        "EnableSsl": true
    }
